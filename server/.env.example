# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/mini-crm
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/mini-crm
MONGO_URI=

# Secret key used to sign JWT tokens. Use a long random string.
JWT_SECRET=

# Port the backend server will run on
PORT=5000

# Credentials used ONLY once, by the "npm run create-admin" script,
# to create the first admin account in the database.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_URL=http://localhost:5173
